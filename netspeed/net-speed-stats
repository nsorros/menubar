#!/usr/bin/env python3
"""Stats over the net-speed log.

Usage:
  net-speed-stats              # all time
  net-speed-stats 24h          # last 24 hours
  net-speed-stats 7d           # last 7 days
  net-speed-stats loc          # break down by location (all time)
  net-speed-stats loc 7d       # break down by location, last 7 days
"""
import json
import os
import re
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from statistics import mean

DATA_DIR = Path(os.environ.get("NETSPEED_DATA_DIR", Path.home() / ".local" / "share" / "netspeed"))
LOG = DATA_DIR / "log.jsonl"
LOCATIONS = DATA_DIR / "locations.json"


def load_locations():
    try:
        return {k.lower(): v for k, v in json.loads(LOCATIONS.read_text()).items()}
    except Exception:
        return {}


def loc_of(rec, locs):
    mac = (rec.get("gateway_mac") or "").lower()
    if not mac:
        return "unknown (no fingerprint)"
    return locs.get(mac) or f"unknown ({mac[-8:]})"


def parse_window(spec: str | None) -> timedelta | None:
    if not spec:
        return None
    m = re.fullmatch(r"(\d+)([hdwm])", spec)
    if not m:
        sys.exit(f"bad window: {spec!r} (use 24h, 7d, 2w, 1m)")
    n, unit = int(m.group(1)), m.group(2)
    return {"h": timedelta(hours=n), "d": timedelta(days=n), "w": timedelta(weeks=n), "m": timedelta(days=30 * n)}[unit]


def mbps(bps: float) -> float:
    return bps / 1_000_000


def fmt_row(label: str, dl: float, ul: float, ping: float | None = None) -> str:
    if ping is None:
        return f"  {label:<8}  ↓ {dl:6.1f} Mbps   ↑ {ul:6.1f} Mbps"
    return f"  {label:<8}  ↓ {dl:6.1f} Mbps   ↑ {ul:6.1f} Mbps   {ping:5.1f} ms"


def main():
    if not LOG.exists():
        sys.exit(f"no log yet at {LOG}")

    args = sys.argv[1:]
    by_location = bool(args) and args[0] in ("loc", "--by-location", "location")
    if by_location:
        args = args[1:]

    window = parse_window(args[0] if args else None)
    cutoff = datetime.now(timezone.utc) - window if window else None

    rows = []
    for line in LOG.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            r = json.loads(line)
        except json.JSONDecodeError:
            continue
        ts = datetime.fromisoformat(r["timestamp"].replace("Z", "+00:00"))
        if cutoff and ts < cutoff:
            continue
        rows.append((ts, r["download"], r["upload"], r["ping"], r))

    if not rows:
        sys.exit("no samples in window")

    win_label = f"last {args[0]}" if window else "all time"

    if by_location:
        locs = load_locations()
        groups = {}
        for row in rows:
            groups.setdefault(loc_of(row[4], locs), []).append(row)
        print(f"net-speed by location ({win_label})  —  {len(rows)} samples")
        for lbl, g in sorted(groups.items(), key=lambda kv: -max(r[1] for r in kv[1])):
            dls, uls, pings = [r[1] for r in g], [r[2] for r in g], [r[3] for r in g]
            print(f"\n{lbl}  ({len(g)} samples)")
            print(fmt_row("max", mbps(max(dls)), mbps(max(uls))))
            print(fmt_row("avg", mbps(mean(dls)), mbps(mean(uls)), mean(pings)))
            print(fmt_row("min", mbps(min(dls)), mbps(min(uls))))
        return

    dls = [r[1] for r in rows]
    uls = [r[2] for r in rows]
    pings = [r[3] for r in rows]
    last = rows[-1]

    print(f"net-speed ({win_label})  —  {len(rows)} sample{'s' if len(rows) != 1 else ''}")
    print(fmt_row("max",  mbps(max(dls)), mbps(max(uls))))
    print(fmt_row("avg",  mbps(mean(dls)), mbps(mean(uls)), mean(pings)))
    print(fmt_row("min",  mbps(min(dls)), mbps(min(uls))))
    print(fmt_row("last", mbps(last[1]),  mbps(last[2]),  last[3]))
    print(f"  latest sample: {last[0].astimezone().strftime('%Y-%m-%d %H:%M')}")


if __name__ == "__main__":
    main()
